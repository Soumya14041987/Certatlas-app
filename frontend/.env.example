# Leave unset in development — Vite proxies /api to http://127.0.0.1:8000.
# In production, point this at the deployed API's origin (no trailing slash).
VITE_API_BASE_URL=

# Supabase Auth (frontend client). The anon key is safe to ship in the built
# bundle by design — Row Level Security is what's supposed to guard data
# behind it, not secrecy of this key. Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Copy to .env and fill in for local development.
# In production, set these as real environment variables / secrets — never
# commit a populated .env file.

CCARF_ENVIRONMENT=development
CCARF_DEBUG=true

# Generate a real one for anything beyond a laptop:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Unset in development, a random key is generated per process (tokens will
# not survive a restart, which is fine locally but never acceptable in prod).
CCARF_SECRET_KEY=

CCARF_DATABASE_URL=sqlite:///./ccarf.db
CCARF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap admin (optional). If both are unset, the first registered account
# becomes the administrator instead.
CCARF_FIRST_ADMIN_EMAIL=
CCARF_FIRST_ADMIN_PASSWORD=

# OAuth sign-in (optional). Each provider only appears on the login page once
# both of its values are set. Redirect URI to register with the provider:
#   {CCARF_PUBLIC_BASE_URL}/api/v1/auth/oauth/{provider}/callback
CCARF_PUBLIC_BASE_URL=http://127.0.0.1:8000
CCARF_FRONTEND_BASE_URL=http://localhost:5173
CCARF_GOOGLE_CLIENT_ID=
CCARF_GOOGLE_CLIENT_SECRET=
CCARF_GITHUB_CLIENT_ID=
CCARF_GITHUB_CLIENT_SECRET=

# "What's new" feed (optional): Anthropic/Claude release videos from YouTube.
# The section is hidden entirely until this is set. Get a key at
# https://console.cloud.google.com/apis/credentials with the YouTube Data
# API v3 enabled.
CCARF_YOUTUBE_API_KEY=
CCARF_YOUTUBE_CHANNEL_HANDLE=@anthropic-ai

# Copy to .env and fill in for local development.
# In production, set these as real environment variables / secrets — never
# commit a populated .env file.

CCARF_ENVIRONMENT=development
CCARF_DEBUG=true
CCARF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase's Postgres connection string (Project Settings -> Database ->
# Connection string -> session pooler). Identity, credentials and sessions
# all live in Supabase Auth now; this app never sees a password.
CCARF_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Project Settings -> API -> Project URL. Derives the JWKS endpoint this
# backend uses to verify bearer tokens the frontend already obtained from
# Supabase Auth (see app/core/supabase_auth.py) — nothing here can issue or
# refresh a token itself.
CCARF_SUPABASE_URL=https://<project-ref>.supabase.co

# Project Settings -> API -> service_role secret. Root-equivalent: bypasses
# both RLS and Auth. Only ever read by the test suite (tests/conftest.py),
# to create/delete throwaway auth users as fixtures via Supabase's Admin
# API. Leave unset for normal app usage — the app itself never reads it.
# NEVER put this in frontend/.env or anything VITE_-prefixed.
CCARF_SUPABASE_SERVICE_ROLE_KEY=

# First real account is a plain user — promote it to admin manually:
#   update public.profiles set role = 'admin' where email = '...';
# (run in the Supabase project's SQL editor)

# "What's new" feed (optional): Anthropic/Claude release videos from YouTube.
# The section is hidden entirely until this is set. Get a key at
# https://console.cloud.google.com/apis/credentials with the YouTube Data
# API v3 enabled.
CCARF_YOUTUBE_API_KEY=
CCARF_YOUTUBE_CHANNEL_HANDLE=@anthropic-ai

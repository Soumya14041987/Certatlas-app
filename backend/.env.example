# Copy to .env and fill in for local development.
# In production, set these as real environment variables / secrets — never
# commit a populated .env file.

CCARF_ENVIRONMENT=development
CCARF_DEBUG=true

# Generate a real one for anything beyond a laptop:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Unset in development, a random key is generated per process (tokens will
# not survive a restart, which is fine locally but never acceptable in prod).
CCARF_SECRET_KEY=

CCARF_DATABASE_URL=sqlite:///./ccarf.db
CCARF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bootstrap admin (optional). If both are unset, the first registered account
# becomes the administrator instead.
CCARF_FIRST_ADMIN_EMAIL=
CCARF_FIRST_ADMIN_PASSWORD=
